rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Profile pictures in the users folder are written by the authenticated
      // owner. Reading is allowed for signed-in users so avatars can load.
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
