rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // DENY ALL by default: the mobile app uploads profile pictures,
      // verification photos, and report attachments to SUPABASE Storage
      // (see api/storage.ts + supabase/storage_policies_*.sql), NOT to
      // Firebase Storage — no client code imports firebase/storage.
      // The previous `request.auth != null` rule let ANY signed-in user
      // read/overwrite ANY object, so it is replaced with a closed rule.
      // If Firebase Storage is ever adopted, scope per-user paths, e.g.
      //   match /users/{uid}/{file} {
      //     allow read: if request.auth != null;
      //     allow write: if request.auth != null && request.auth.uid == uid;
      //   }
      allow read, write: if false;
    }
  }
}
