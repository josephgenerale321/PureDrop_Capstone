# Copy to `.env` and fill in values. `.env` is gitignored — never commit it.
# Secrets (Sightengine, Brevo, service-role keys) live ONLY in Supabase /
# Firebase server secrets — NEVER as EXPO_PUBLIC_* (those ship in the app binary).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=reports
EXPO_PUBLIC_SUPABASE_AVATAR_BUCKET=regular_user
EXPO_PUBLIC_SUPABASE_AVATAR_FOLDER=users
EXPO_PUBLIC_SUPABASE_VERIFICATION_BUCKET=verification_id
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_MAPS_KEY
EXPO_PUBLIC_AI_ASSISTANT_ENABLED=false
EXPO_PUBLIC_MAPTILER_API_KEY=YOUR_MAPTILER_KEY
